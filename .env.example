# Copy to .env.local for local runs, or set these in Vercel: Project > Settings > Environment Variables.
# Without a key, imports still work for pasted text and recipe websites (simple rules); YouTube needs the key.
GEMINI_API_KEY=
# Optional: a comma-separated list of models to try, newest first.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash
# Optional: require an access code for imports; the Add screen then asks for it once and remembers it.
# IMPORT_CODE=
# Optional: imports per address per 10 minutes (default 12).
# IMPORT_LIMIT=12
